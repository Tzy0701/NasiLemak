{
  // Same Worker as production, but with shortened timers for integration tests.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "nasi-lemak-online-test",
  "main": "../src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "vars": { "ALLOWED_ORIGINS": "", "FAST_TIMERS": "1" }
}
