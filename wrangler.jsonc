{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nasi-lemak-online",
  "account_id": "a8265c7cf48c59f625939c3b1ab3f714",
  "main": "src/server/cloudflare/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "vars": { "ALLOWED_ORIGINS": "" }
}
