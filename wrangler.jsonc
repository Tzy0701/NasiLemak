{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nasi-lemak-online",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    // React SPA built by Vite. Unknown paths fall back to index.html,
    // /api/* always reaches the Worker first.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [
    // SQLite-backed Durable Object storage (required for new classes).
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ],
  "vars": {
    // Optional: comma-separated extra origins allowed to open WebSockets.
    "ALLOWED_ORIGINS": ""
  }
}
