# Cloudflare Worker serves both frontend and API. Leave this empty.
VITE_API_URL=
# Optional local Node test host settings. Production Worker uses wrangler.jsonc.
# Exact comma-separated frontend origins; empty permits same-origin only.
ALLOWED_ORIGINS=
# Local files survive process restarts only while this directory survives.
ROOM_STORE_PATH=.room-data
PORT=8790
