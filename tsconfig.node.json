{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.ts", "vitest.integration.config.ts", "vitest.cloudflare.config.ts", "playwright.config.ts", "scripts", "tests", "src/server", "src/game", "src/shared", "src/client/i18n", "src/client/game/animations.ts"],
  "exclude": ["src/server/cloudflare"]
}
