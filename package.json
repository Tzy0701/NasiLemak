{
  "name": "nasi-lemak-online",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Private Nasi Lemak multiplayer game: portable Node.js rooms, React frontend and free hosting configuration.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build && esbuild src/server/node/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.mjs",
    "preview": "npm start",
    "typecheck": "tsc -b",
    "test": "vitest run && vitest run -c vitest.integration.config.ts",
    "test:unit": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "simulate": "tsx scripts/simulate.ts",
    "start": "node dist/server/index.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
